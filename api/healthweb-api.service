# /etc/systemd/system/healthweb-api.service
# sudo cp healthweb-api.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now healthweb-api
[Unit]
Description=health-web read API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/health-web-api
EnvironmentFile=/opt/health-web-api/.env
ExecStart=/opt/health-web-api/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
